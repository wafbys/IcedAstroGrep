<Window
    x:Class="WinUiShell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Fluent layout and interaction:
        * 4px spacing grid, 24px page margin (Windows geometry guidance)
        * only control-provided visuals, so the system theme (including dark mode) is respected;
          no literal colours and no CornerRadius, since the framework owns ControlCornerRadius
        * input labels come from each control's Header, which is also its accessibility label
        * keyboard: Enter searches, Escape cancels, Ctrl+F focuses the search box, Alt+S/Alt+C access keys
        * errors are reported through an InfoBar rather than a coloured text block
    -->
    <Grid Margin="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>

        <!-- Disabled while a search runs: nothing here can be changed mid-search. -->
        <StackPanel x:Name="SearchPanel" Grid.Row="0" Spacing="8">
            <TextBox x:Name="PathBox" Header="Folder" Text="C:\" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="SearchBox" Header="Find" Width="320" Text="needle" />
                <TextBox x:Name="FileTypesBox" Header="File types" Width="160" Text="*.*" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox x:Name="RecurseCheck" Content="Subfolders" IsChecked="True" />
                <CheckBox x:Name="CaseCheck" Content="Case sensitive" />
                <CheckBox x:Name="WholeWordCheck" Content="Whole word" />
                <CheckBox x:Name="RegexCheck" Content="Regular expressions" />
                <CheckBox x:Name="NegationCheck" Content="Negation" />
                <CheckBox x:Name="FileNamesOnlyCheck" Content="File names only" />
                <ComboBox x:Name="LanguageBox" Header="Language" MinWidth="180" VerticalAlignment="Bottom"
                          DisplayMemberPath="DisplayName" SelectionChanged="LanguageChanged" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="StartButton" Content="Search" Click="StartSearchClick" AccessKey="S">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Invoked="SearchAcceleratorInvoked" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelSearchClick" AccessKey="C" IsEnabled="False">
                <Button.KeyboardAccelerators>
                    <!-- on the disabled button, so Escape only does something while a search runs -->
                    <KeyboardAccelerator Key="Escape" Invoked="CancelAcceleratorInvoked" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button x:Name="PrintButton" Content="Print" Click="PrintResultsClick" />
            <ProgressRing x:Name="Progress" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="PluginText" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
        </StackPanel>

        <InfoBar x:Name="ErrorBar" Grid.Row="2" Severity="Error" IsOpen="False" IsClosable="True" />

        <ListView x:Name="FileList" Grid.Row="5" SelectionMode="Single"
                  AutomationProperties.Name="Files with hits" />

        <!-- The results pane is the same HTML an export produces, with each line carrying the source
             position a click should open. Printing comes with the control. -->
        <WebView2 x:Name="ResultsView" Grid.Row="6" AutomationProperties.Name="Search results" />
    </Grid>
</Window>
