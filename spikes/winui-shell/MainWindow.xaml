<Window
    x:Class="WinUiShell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- M1: the search loop. Everything below the status line is the same engine the WinForms
             shell drives, and the results pane is the shared ResultDocument. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Folder" VerticalAlignment="Center" Width="60" />
            <TextBox x:Name="PathBox" Width="520" Text="C:\" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Find" VerticalAlignment="Center" Width="60" />
            <TextBox x:Name="SearchBox" Width="300" Text="needle" />
            <TextBlock Text="File types" VerticalAlignment="Center" />
            <TextBox x:Name="FileTypesBox" Width="120" Text="*.*" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
            <CheckBox x:Name="RecurseCheck" Content="Subfolders" IsChecked="True" />
            <CheckBox x:Name="CaseCheck" Content="Case sensitive" />
            <CheckBox x:Name="WholeWordCheck" Content="Whole word" />
            <CheckBox x:Name="RegexCheck" Content="Regular expressions" />
            <CheckBox x:Name="NegationCheck" Content="Negation" />
            <CheckBox x:Name="FileNamesOnlyCheck" Content="File names only" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button x:Name="StartButton" Content="Search" Click="StartSearchClick" />
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelSearchClick" IsEnabled="False" />
            <ProgressRing x:Name="Progress" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="ready" />
            <TextBlock x:Name="PluginText" VerticalAlignment="Center" Foreground="Gray" />
            <TextBlock Text="Language" VerticalAlignment="Center" />
            <ComboBox x:Name="LanguageBox" MinWidth="170" DisplayMemberPath="DisplayName" SelectionChanged="LanguageChanged" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="Firebrick" TextWrapping="Wrap" />

        <ListView x:Name="FileList" Grid.Row="5" SelectionMode="Single" />

        <TextBox x:Name="ResultsPane" Grid.Row="6"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </Grid>
</Window>
