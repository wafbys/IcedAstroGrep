<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <!--
      The project is named after the shell, the assembly after the product: both shells build
      IcedAstroGrep.exe, and Language.cs finds its files as "<assembly>.Language.<culture>.xml" while
      the resource class is IcedAstroGrep.Properties.Resources, so neither name may drift. The shells
      are shipped in separate folders, which is also why two projects may share an assembly name.
      IcedAstroGrep.WinUI does the same.
    -->
    <RootNamespace>IcedAstroGrep</RootNamespace>
    <AssemblyName>IcedAstroGrep</AssemblyName>
    <ApplicationIcon>Images\AstroGrep_Icon_256x256.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>IcedAstroGrep.Windows.Program</StartupObject>
    <EnableDefaultEmbeddedResourceItems>true</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Only what this shell itself uses: AvalonEdit for the results viewer. The plug-ins' packages
      (DocumentFormat.OpenXml, ExcelDataReader, ExcelNumberFormat, TagLibSharp) belong to
      IcedAstroGrep.AppServices, which owns the plug-ins, and NLog belongs to IcedAstroGrep.Core, which
      owns LogClient; both reach this executable through the project reference. CommandLineParser is
      gone with CLOptions.cs: the command line is parsed by CommandLineProcessing in AppServices.
    -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>
  <ItemGroup>
    <!-- IcedAstroGrep.IFilter arrives with AppServices, which is the only thing that uses it. -->
    <ProjectReference Include="..\IcedAstroGrep.AppServices\IcedAstroGrep.AppServices.csproj" />
    <ProjectReference Include="..\IcedAstroGrep.Core\IcedAstroGrep.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The language files stay with Language.cs, which resolves them against its own assembly. -->
    <EmbeddedResource Include="Language\*.xml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Images\AstroGrep_256x256.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!--
      pdftotext.exe is redistributed inside IcedAstroGrep.AppServices (the PDF plug-in embeds it and
      extracts it at run time), and its licence requires the Xpdf documentation to be distributed
      together with it, so both files ship beside the application.
    -->
    <None Include="..\..\third-party\xpdf\*" LinkBase="ThirdParty\xpdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
